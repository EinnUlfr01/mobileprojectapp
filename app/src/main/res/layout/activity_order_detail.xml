<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fitsSystemWindows="true" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />
    <!-- ListView: các món trong đơn, phần thông tin đơn nằm ở header -->
    <ListView android:id="@+id/listView" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:divider="@null" android:padding="12dp" />
    <LinearLayout android:id="@+id/memberActions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:visibility="gone">
        <Button android:id="@+id/btnReorder" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Đặt lại" />
        <Button android:id="@+id/btnChatOrder" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="Hỏi cửa hàng" />
    </LinearLayout>
    <Button android:id="@+id/btnPay" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginStart="12dp" android:layout_marginTop="12dp" android:layout_marginEnd="12dp"
        android:text="Thanh toán qua VNPay" android:visibility="gone" />
    <Button android:id="@+id/btnCancel" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="52dp" android:layout_margin="12dp"
        android:text="Hủy đơn" android:textColor="@color/danger" android:visibility="gone" />
</LinearLayout>
