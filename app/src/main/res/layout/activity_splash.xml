<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/primary" android:gravity="center" android:orientation="vertical">

    <TextView android:layout_width="104dp" android:layout_height="104dp"
        android:background="@drawable/bg_search" android:gravity="center"
        android:text="🍜" android:textSize="52sp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="@string/app_name"
        android:textColor="@color/white" android:textSize="30sp" android:textStyle="bold" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Đặt món nhanh, giao tận nơi"
        android:textColor="@color/white" android:textSize="15sp" />

    <ProgressBar android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginTop="40dp" android:indeterminateTint="@color/white" />
</LinearLayout>
