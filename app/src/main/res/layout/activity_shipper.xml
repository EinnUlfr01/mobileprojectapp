<?xml version="1.0" encoding="utf-8"?>
<!-- Màn shipper: số liệu hôm nay + 3 tab Đơn chờ nhận / Đang giao / Đã giao (ListView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fitsSystemWindows="true" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/primary" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvRole" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Shipper" android:textColor="@color/white" android:textSize="13sp" />
            <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <Button android:id="@+id/btnLogout" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content" android:layout_height="44dp" android:text="Đăng xuất"
            android:textColor="@color/white" app:strokeColor="@color/white" />
    </LinearLayout>
    <!-- 3 ô số liệu -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingTop="10dp" android:paddingEnd="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_margin="4dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="10dp">
            <TextView style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đơn chờ nhận" android:textSize="12sp" />
            <TextView android:id="@+id/tvAvailable" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="…" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_margin="4dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="10dp">
            <TextView style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang giao" android:textSize="12sp" />
            <TextView android:id="@+id/tvDelivering" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="…" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4"
            android:layout_margin="4dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="10dp">
            <TextView style="@style/Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hôm nay" android:textSize="12sp" />
            <TextView android:id="@+id/tvToday" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="…" android:textColor="@color/primary" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/white" />
    <TextView android:id="@+id/tvEmpty" style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="24dp" android:visibility="gone" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <ListView android:id="@+id/listView" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:divider="@null" android:padding="12dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
